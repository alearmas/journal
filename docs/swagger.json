{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API for the Trading Journal – track cauciones (fixed-term investments), capital movements, and compare investment instruments.",
        "title": "Trading Journal API",
        "contact": {
            "name": "Trading Journal"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/capital/balance": {
            "get": {
                "description": "Get capital summary per broker: deposits, withdrawals, deployed principal, available cash, and P\u0026L.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "capital"
                ],
                "summary": "Capital balance",
                "parameters": [
                    {
                        "type": "string",
                        "example": "Balanz",
                        "description": "Filter by broker name",
                        "name": "broker",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.BrokerSummaryResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cauciones": {
            "get": {
                "description": "Get all cauciones ordered by trade date ascending.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cauciones"
                ],
                "summary": "List cauciones",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.CaucionResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Register a new caucion (fixed-term investment). Gross interest = principal × (tna/100) × (term_days/360).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cauciones"
                ],
                "summary": "Create a caucion",
                "parameters": [
                    {
                        "description": "Caucion data",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CreateCaucionRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.CaucionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cauciones/export": {
            "get": {
                "description": "Download cauciones as a CSV file. Optionally filter by month.",
                "produces": [
                    "text/csv"
                ],
                "tags": [
                    "cauciones"
                ],
                "summary": "Export CSV",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01",
                        "description": "Optional month filter YYYY-MM",
                        "name": "month",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "cauciones.csv",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cauciones/report": {
            "get": {
                "description": "Get aggregates and weighted-average TNA for a specific month (YYYY-MM).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cauciones"
                ],
                "summary": "Monthly report",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01",
                        "description": "Month in YYYY-MM format",
                        "name": "month",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.MonthSummaryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cauciones/summary": {
            "get": {
                "description": "Get aggregate totals (principal, gross, fees, taxes, net) across all cauciones.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cauciones"
                ],
                "summary": "Global summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SummaryResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/compare": {
            "get": {
                "description": "Compare caución net return vs plazo fijo and money market gross returns for the same principal and term.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "compare"
                ],
                "summary": "Compare investment instruments",
                "parameters": [
                    {
                        "type": "string",
                        "example": "1000000.00",
                        "description": "Principal amount (decimal)",
                        "name": "principal",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "Term in days",
                        "name": "days",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "85.5",
                        "description": "Caución TNA (%, e.g. 85.5)",
                        "name": "caucion_tna",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "50.00",
                        "description": "Caución fees (decimal)",
                        "name": "fees",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "421.00",
                        "description": "Caución taxes (decimal)",
                        "name": "taxes",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "80.0",
                        "description": "Plazo fijo TNA (%, e.g. 80.0)",
                        "name": "pf_tna",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "75.0",
                        "description": "Money market TNA (%, e.g. 75)",
                        "name": "mm_tna",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.CompareResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/movimientos": {
            "get": {
                "description": "Get all capital movements (deposits and withdrawals) ordered by date.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movimientos"
                ],
                "summary": "List movimientos",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.MovimientoResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/movimientos/deposit": {
            "post": {
                "description": "Register a capital deposit for a broker. Amount must be \u003e 0.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movimientos"
                ],
                "summary": "Register a deposit",
                "parameters": [
                    {
                        "description": "Deposit data",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.RegisterMovimientoRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.MovimientoResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/movimientos/withdraw": {
            "post": {
                "description": "Register a capital withdrawal for a broker. Amount must be \u003e 0.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movimientos"
                ],
                "summary": "Register a withdrawal",
                "parameters": [
                    {
                        "description": "Withdrawal data",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.RegisterMovimientoRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.MovimientoResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ppi/movements": {
            "get": {
                "description": "Returns the unprocessed movement list from PPI. Use this to inspect field names and values before adjusting sync mappings.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ppi-debug"
                ],
                "summary": "Raw PPI movements",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01-01",
                        "description": "Start date YYYY-MM-DD (default: 30 days ago)",
                        "name": "date_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-03-06",
                        "description": "End date YYYY-MM-DD (default: today)",
                        "name": "date_to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ppi.Movement"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ppi/orders": {
            "get": {
                "description": "Returns the unprocessed order list from PPI. Use this to verify caucion field mapping (operation, price=TNA, amount=principal, operationMaxDate=maturity).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ppi-debug"
                ],
                "summary": "Raw PPI orders",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01-01",
                        "description": "Start date YYYY-MM-DD (default: 30 days ago)",
                        "name": "date_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-03-06",
                        "description": "End date YYYY-MM-DD (default: today)",
                        "name": "date_to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ppi.Order"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sync": {
            "post": {
                "description": "Fetch capital movements and cauciones from PPI for the given date range and import them. Defaults to the last 30 days.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sync"
                ],
                "summary": "Sync from PPI",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01-01",
                        "description": "Start date YYYY-MM-DD (default: 30 days ago)",
                        "name": "date_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-03-06",
                        "description": "End date YYYY-MM-DD (default: today)",
                        "name": "date_to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SyncResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.BrokerSummaryResponse": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "string",
                    "example": "1000000.00"
                },
                "broker": {
                    "type": "string",
                    "example": "Balanz"
                },
                "deployed_principal": {
                    "type": "string",
                    "example": "3000000.00"
                },
                "net_balance": {
                    "type": "string",
                    "example": "4000000.00"
                },
                "pnl_percent": {
                    "type": "string",
                    "example": "0.1904"
                },
                "total_deposited": {
                    "type": "string",
                    "example": "5000000.00"
                },
                "total_net_interest": {
                    "type": "string",
                    "example": "9520.00"
                },
                "total_withdrawn": {
                    "type": "string",
                    "example": "1000000.00"
                }
            }
        },
        "handler.CaucionResponse": {
            "type": "object",
            "properties": {
                "broker": {
                    "type": "string",
                    "example": "Balanz"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-01-10T12:00:00Z"
                },
                "fees": {
                    "type": "string",
                    "example": "50.00"
                },
                "gross_interest": {
                    "type": "string",
                    "example": "2375.00"
                },
                "id": {
                    "type": "string",
                    "example": "a1b2c3d4e5f6240910ab"
                },
                "maturity_date": {
                    "type": "string",
                    "example": "2026-01-11"
                },
                "net_interest": {
                    "type": "string",
                    "example": "1904.00"
                },
                "notes": {
                    "type": "string",
                    "example": "overnight"
                },
                "principal": {
                    "type": "string",
                    "example": "1000000.00"
                },
                "taxes": {
                    "type": "string",
                    "example": "421.00"
                },
                "term_days": {
                    "type": "integer",
                    "example": 1
                },
                "tna": {
                    "type": "string",
                    "example": "85.5"
                },
                "trade_date": {
                    "type": "string",
                    "example": "2026-01-10"
                }
            }
        },
        "handler.CompareResponse": {
            "type": "object",
            "properties": {
                "caucion_net": {
                    "type": "string",
                    "example": "1904.00"
                },
                "days": {
                    "type": "integer",
                    "example": 1
                },
                "mm_gross": {
                    "type": "string",
                    "example": "2083.33"
                },
                "pf_gross": {
                    "type": "string",
                    "example": "2222.22"
                },
                "principal": {
                    "type": "string",
                    "example": "1000000.00"
                }
            }
        },
        "handler.CreateCaucionRequest": {
            "type": "object",
            "properties": {
                "broker": {
                    "type": "string",
                    "example": "Balanz"
                },
                "fees": {
                    "type": "string",
                    "example": "50.00"
                },
                "notes": {
                    "type": "string",
                    "example": "overnight"
                },
                "principal": {
                    "type": "string",
                    "example": "1000000.00"
                },
                "taxes": {
                    "type": "string",
                    "example": "421.00"
                },
                "term_days": {
                    "type": "integer",
                    "example": 1
                },
                "tna": {
                    "type": "string",
                    "example": "85.5"
                },
                "trade_date": {
                    "type": "string",
                    "example": "2026-01-10"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request body"
                }
            }
        },
        "handler.MonthSummaryResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 5
                },
                "month": {
                    "type": "string",
                    "example": "2026-01"
                },
                "total_fees": {
                    "type": "string",
                    "example": "250.00"
                },
                "total_gross": {
                    "type": "string",
                    "example": "11875.00"
                },
                "total_net": {
                    "type": "string",
                    "example": "9520.00"
                },
                "total_principal": {
                    "type": "string",
                    "example": "5000000.00"
                },
                "total_taxes": {
                    "type": "string",
                    "example": "2105.00"
                },
                "weighted_avg_tna": {
                    "type": "string",
                    "example": "85.5"
                }
            }
        },
        "handler.MovimientoResponse": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "string",
                    "example": "1000000.00"
                },
                "broker": {
                    "type": "string",
                    "example": "Balanz"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-01-01T12:00:00Z"
                },
                "date": {
                    "type": "string",
                    "example": "2026-01-01"
                },
                "id": {
                    "type": "string",
                    "example": "a1b2c3d4e5f6240910ab"
                },
                "notes": {
                    "type": "string",
                    "example": "transferencia inicial"
                },
                "type": {
                    "type": "string",
                    "example": "deposito"
                }
            }
        },
        "handler.RegisterMovimientoRequest": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "string",
                    "example": "1000000.00"
                },
                "broker": {
                    "type": "string",
                    "example": "Balanz"
                },
                "date": {
                    "type": "string",
                    "example": "2026-01-01"
                },
                "notes": {
                    "type": "string",
                    "example": "transferencia inicial"
                }
            }
        },
        "handler.SummaryResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 5
                },
                "total_fees": {
                    "type": "string",
                    "example": "250.00"
                },
                "total_gross": {
                    "type": "string",
                    "example": "11875.00"
                },
                "total_net": {
                    "type": "string",
                    "example": "9520.00"
                },
                "total_principal": {
                    "type": "string",
                    "example": "5000000.00"
                },
                "total_taxes": {
                    "type": "string",
                    "example": "2105.00"
                }
            }
        },
        "handler.SyncResponse": {
            "type": "object",
            "properties": {
                "cauciones_imported": {
                    "type": "integer",
                    "example": 2
                },
                "cauciones_skipped": {
                    "type": "integer",
                    "example": 0
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "movimientos_imported": {
                    "type": "integer",
                    "example": 3
                },
                "movimientos_skipped": {
                    "type": "integer",
                    "example": 5
                }
            }
        },
        "ppi.Movement": {
            "type": "object",
            "properties": {
                "agreementDate": {
                    "type": "string"
                },
                "amount": {
                    "type": "number"
                },
                "balance": {
                    "type": "number"
                },
                "currency": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "quantity": {
                    "type": "number"
                },
                "settlementDate": {
                    "type": "string"
                },
                "ticker": {
                    "type": "string"
                }
            }
        },
        "ppi.Order": {
            "type": "object",
            "properties": {
                "amount": {
                    "description": "principal",
                    "type": "number"
                },
                "currency": {
                    "type": "string"
                },
                "date": {
                    "description": "trade date",
                    "type": "string"
                },
                "externalID": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "instrumentType": {
                    "type": "string"
                },
                "operation": {
                    "description": "e.g. \"COLOCAR-CAUCIÓN\"",
                    "type": "string"
                },
                "operationMaxDate": {
                    "description": "maturity date for cauciones",
                    "type": "string"
                },
                "operationType": {
                    "type": "string"
                },
                "orderType": {
                    "type": "string"
                },
                "price": {
                    "description": "TNA (%) for cauciones",
                    "type": "number"
                },
                "quantity": {
                    "type": "number"
                },
                "settlement": {
                    "description": "e.g. \"A-24HS\"",
                    "type": "string"
                },
                "status": {
                    "description": "e.g. \"TERMINADA\", \"PENDIENTE\"",
                    "type": "string"
                },
                "ticker": {
                    "type": "string"
                }
            }
        }
    }
}